# Sao chép file này thành .env (docker compose tự đọc .env). Đổi mật khẩu khi triển khai thật.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB=keycloak
FLOWABLE_DB=flowable
POSTGRES_PORT=5432

# MinIO (API chỉ truy cập qua APISIX, không publish cổng 9000)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dxos-data
# Bucket riêng cho số liệu cảm biến IoT, có Object Lock (WORM: ghi một lần, không sửa/xóa trong thời hạn giữ).
# Object Lock chỉ bật được lúc tạo bucket. Chế độ: GOVERNANCE (root còn gỡ được, dùng khi phát triển/thử) hoặc
# COMPLIANCE (kể cả root cũng không phá được, KHÔNG hoàn tác: chỉ dùng khi triển khai thật).
# Số ngày giữ: 1825 (5 năm). Xuất khẩu sang EU thường cần lưu hồ sơ kỹ thuật 10 năm: đặt 3650. Chỉ áp cho tệp ghi sau khi đổi.
IOT_BUCKET=dxos-iot
IOT_LOCK_MODE=GOVERNANCE
# Bắt buộc thêm dòng sau (bỏ dấu #) mới được dùng COMPLIANCE, vì không hoàn tác:
# IOT_LOCK_CONFIRM_COMPLIANCE=yes
IOT_RETENTION_DAYS=1825

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# Flowable (REST, chỉ truy cập nội bộ qua APISIX)
FLOWABLE_ADMIN_USER=rest-admin
FLOWABLE_ADMIN_PASSWORD=change_me_flowable

# APISIX
APISIX_ADMIN_KEY=change_me_apisix_admin_key_32chars
APISIX_VIEWER_KEY=change_me_apisix_viewer_key_32chars
APISIX_GATEWAY_PORT=9080
APISIX_ADMIN_PORT=9180
KEYCLOAK_REALM=dxos
KEYCLOAK_CLIENT_ID=dxos-api
KEYCLOAK_CLIENT_SECRET=change_me_client_secret
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
# Tên miền HTTPS tự cấp chứng chỉ qua Caddy khi chạy profile prod: docker compose --profile prod up -d
# CADDY_DOMAIN=langnghe.example.vn

# Tầng 3: truy xuất nguồn gốc
TRACE_DB=traceability

# trace-api đọc dữ liệu IoT từ MinIO bằng tài khoản CHỈ ĐỌC (tạo bởi scripts/setup-apisix-routes.sh)
TRACE_S3_USER=trace-reader
TRACE_S3_PASSWORD=change_me_trace_reader_pw

# Tệp đính kèm hồ sơ OCOP: bucket riêng + tài khoản MinIO riêng cho trace-api (tạo bởi scripts/setup-apisix-routes.sh).
# Cổng gác chặn bucket này với mọi người dùng cuối; tệp chỉ lấy ra được qua trace-api sau khi kiểm quyền xem hồ sơ.
DOCS_BUCKET=dxos-docs
TRACE_DOCS_USER=trace-docs
TRACE_DOCS_PASSWORD=change_me_trace_docs_pw

# Quét mã độc tệp tải lên bằng ClamAV (dịch vụ 'clamav' chỉ chạy ở profile full: docker compose --profile full up -d).
# CLAMAV_REQUIRED=false (mặc định, chế độ gọn nhẹ): không có ClamAV thì vẫn nhận tệp và ghi avStatus "skipped-lite-profile".
# CLAMAV_REQUIRED=true (bắt buộc khi triển khai thật, scripts/prod-check.js kiểm tra): không quét được thì từ chối tải lên (503).
# Để trống CLAMAV_HOST trong môi trường không dùng compose thì tắt bước quét.
CLAMAV_HOST=clamav
CLAMAV_REQUIRED=false

# Quét nhắc hạn xử lý hồ sơ OCOP (tạo thông báo trong ứng dụng) mỗi NOTIFY_INTERVAL_MINUTES phút; 0 = tắt tự động (quản trị vẫn quét tay được).
NOTIFY_INTERVAL_MINUTES=60

# Hồ dữ liệu phân tích: bucket riêng + xuất Parquet phân vùng Hive (coop/year/month) mỗi LAKE_INTERVAL_HOURS giờ; 0 = tắt tự động.
LAKE_BUCKET=dxos-lake
LAKE_S3_USER=trace-lake
LAKE_S3_PASSWORD=change_me_trace_lake_pw
LAKE_INTERVAL_HOURS=24

# Khóa nội bộ để trace-api gọi Flowable qua route nội bộ của cổng gác (cổng 9081 chỉ trong mạng Docker). Chỉ cho ba thao tác của quy trình OCOP.
FLOWABLE_PROXY_KEY=change_me_flowable_proxy_key

# Triển khai thật (xem docs/TRIEN-KHAI-INTERNET.md): địa chỉ công khai HTTPS của Keycloak và của giao diện. Bỏ dấu # và điền khi triển khai.
# KC_HOSTNAME_URL=https://dangnhap.example.vn
# Mặc định (không đặt gì) trang đăng nhập nằm cùng gốc với giao diện (FRONTEND_ORIGIN, cổng 3000): người dùng không thấy địa chỉ đổi sang cổng 8080.
# Muốn Keycloak ở cổng riêng như trước: KC_HOSTNAME_URL=http://localhost:8080 và NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080 trong frontend/.env.local.

# Neo băm đầu chuỗi nhật ký kiểm toán: bucket riêng có Object Lock + tài khoản chỉ ghi/đọc/liệt kê anchors/ (không xóa),
# tạo bởi scripts/setup-apisix-routes.sh. trace-api ghi một bản neo mỗi ANCHOR_INTERVAL_MINUTES phút (0 = tắt tự động; vẫn neo tay được).
ANCHOR_BUCKET=dxos-audit
ANCHOR_S3_USER=trace-anchor
ANCHOR_S3_PASSWORD=change_me_trace_anchor_pw
ANCHOR_INTERVAL_MINUTES=60

# Nhật ký kiểm toán: khóa để cổng gác (APISIX http-logger) gửi nhật ký về trace-api qua mạng nội bộ (/internal/audit).
AUDIT_INGEST_KEY=change_me_audit_ingest_key

# Vòng đời dữ liệu: lịch sử hồ sơ đã kết thúc quá ARCHIVE_KEEP_DAYS ngày được chuyển từ PostgreSQL (nóng) sang MinIO (lạnh),
# kiểm tra mỗi ARCHIVE_INTERVAL_HOURS giờ. Đặt ARCHIVE_INTERVAL_HOURS=0 để tắt chạy tự động (vẫn chạy tay được ở trang Data).
ARCHIVE_KEEP_DAYS=90
ARCHIVE_INTERVAL_HOURS=24

# Thiết bị IoT (gateway xưởng) có client Keycloak riêng, chỉ có role iot-writer (chỉ ghi vào iot/)
KEYCLOAK_IOT_CLIENT_ID=dxos-iot
KEYCLOAK_IOT_CLIENT_SECRET=change_me_iot_client_secret
# Cổng MQTT cục bộ (127.0.0.1) của Eclipse Mosquitto cho thiết bị biên ESP32 / trình mô phỏng ký số Ed25519
MQTT_PORT=1883

# Mời thành viên: trace-api tạo tài khoản qua client dịch vụ này (chỉ có quyền quản lý người dùng, không phải admin Keycloak)
KC_MEMBERS_CLIENT=dxos-members
KC_MEMBERS_SECRET=change_me_members_client_secret
# Địa chỉ giao diện dùng để dựng liên kết mời (người được mời mở liên kết này). Bỏ trống thì dùng FRONTEND_ORIGIN.
MEMBERS_INVITE_ORIGIN=
# Liên kết mời hết hạn sau bao nhiêu ngày
MEMBERS_INVITE_DAYS=7
