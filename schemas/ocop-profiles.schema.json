{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langnghe-dx-os.local/schemas/ocop-profiles.schema.json",
  "title": "DX-OS OCOP Local Criteria Configuration",
  "description": "Chuẩn hóa cấu hình thang điểm, hạng sao, giấy tờ và hạn nhắc OCOP theo địa phương (config/ocop-profiles.json).",
  "type": "object",
  "required": ["defaultProfile", "profiles"],
  "additionalProperties": false,
  "properties": {
    "_doc": { "type": "string" },
    "defaultProfile": { "type": "string", "pattern": "^[a-z0-9-]{2,60}$" },
    "profiles": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]{2,60}$": { "$ref": "#/$defs/profile" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["name", "effectiveFrom", "verified", "authority", "scoring", "attachments", "validityMonths", "renewalWindowDays", "groups", "checklist"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "effectiveFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "verified": { "type": "boolean" },
        "sourceNote": { "type": "string" },
        "legalBasis": { "type": "array", "items": { "type": "string" } },
        "authority": {
          "type": "object",
          "required": ["star3and4", "star5"],
          "additionalProperties": false,
          "properties": {
            "coordinatingOffice": { "type": "string" },
            "council": { "type": "string" },
            "minQuorum": { "type": "number", "minimum": 1 },
            "star3and4": { "type": "string", "minLength": 1 },
            "star5": { "type": "string", "minLength": 1 }
          }
        },
        "scoring": {
          "type": "object",
          "required": ["maxTotal", "parts", "stars", "minStarsRecognized"],
          "additionalProperties": false,
          "properties": {
            "maxTotal": { "type": "number", "minimum": 1 },
            "minStarsRecognized": { "type": "number", "minimum": 1, "maximum": 5 },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["key", "label", "max"],
                "additionalProperties": false,
                "properties": {
                  "key": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "max": { "type": "number", "minimum": 1 }
                }
              }
            },
            "stars": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stars", "min", "max", "level"],
                "additionalProperties": false,
                "properties": {
                  "stars": { "type": "number", "minimum": 1, "maximum": 5 },
                  "min": { "type": "number", "minimum": 0 },
                  "max": { "type": "number", "minimum": 0 },
                  "level": { "type": "string", "enum": ["khong-cong-nhan", "tinh", "quoc-gia"] }
                }
              }
            }
          }
        },
        "attachments": {
          "type": "object",
          "required": ["maxBytes", "maxPerApplication", "types"],
          "additionalProperties": false,
          "properties": {
            "maxBytes": { "type": "number", "minimum": 1 },
            "maxPerApplication": { "type": "number", "minimum": 1 },
            "types": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"] }
            }
          }
        },
        "validityMonths": { "type": "number", "minimum": 1 },
        "renewalWindowDays": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "number", "minimum": 1 },
            "to": { "type": "number", "minimum": 0 }
          }
        },
        "communeReviewWorkingDays": { "type": "number", "minimum": 1 },
        "reminders": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewWarnWorkingDays": { "type": "number", "minimum": 1 },
            "revisionReminderDays": { "type": "number", "minimum": 1 },
            "awaitingResultReminderDays": { "type": "number", "minimum": 1 }
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "submitBefore", "completeBefore"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "submitBefore": { "type": "string" },
              "completeBefore": { "type": "string" }
            }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "subjectTypes": { "type": "array", "items": { "type": "string" } },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "required"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "onlyGroups": { "type": "array", "items": { "type": "string" } },
              "exceptGroups": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
