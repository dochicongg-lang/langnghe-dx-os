<!--
  Quy trình HỖ TRỢ hồ sơ OCOP (P1 nâng cấp):
    - Timer Boundary Events không ngắt (non-interrupting): nhắc HTX ở P12D (12 ngày) và leo thang lên cơ quan OCOP ở P15D (15 ngày).
    - Parallel Multi-Instance cho Hội đồng OCOP chấm điểm độc lập (chỉ kích hoạt khi biến councilMembers không rỗng; mặc định đi thẳng
      tới officialResult để giữ tương thích hoàn toàn khi không tổ chức hội đồng online).
  Nạp bằng: bash scripts/setup-ocop-workflow.sh
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="dxos">

  <process id="dxosOcopSupport" name="Hỗ trợ hồ sơ OCOP (Timer &amp; Hội đồng Multi-Instance)" isExecutable="true">
    <startEvent id="start" name="Người nộp gửi hồ sơ"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="reviewByCoop"/>

    <userTask id="reviewByCoop" name="HTX sơ duyệt hồ sơ" flowable:candidateGroups="coop-officer"/>

    <!-- Timer Boundary Event (12 ngày): tự động nhắc nhở cán bộ HTX sơ duyệt -->
    <boundaryEvent id="reviewWarnTimer" name="Nhắc hạn sơ duyệt (12 ngày)" attachedToRef="reviewByCoop" cancelActivity="false">
      <timerEventDefinition>
        <timeDuration>P12D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="fTimerWarn" sourceRef="reviewWarnTimer" targetRef="coopReviewWarning"/>
    <userTask id="coopReviewWarning" name="Nhắc HTX sơ duyệt hồ sơ quá 12 ngày" flowable:candidateGroups="coop-officer"/>
    <sequenceFlow id="fTimerWarnEnd" sourceRef="coopReviewWarning" targetRef="endTimerWarn"/>
    <endEvent id="endTimerWarn" name="Đã phát nhắc hạn sơ duyệt"/>

    <!-- Timer Boundary Event (15 ngày): tự động leo thang khi quá hạn sơ duyệt -->
    <boundaryEvent id="reviewOverdueTimer" name="Quá hạn sơ duyệt (15 ngày)" attachedToRef="reviewByCoop" cancelActivity="false">
      <timerEventDefinition>
        <timeDuration>P15D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="fTimerEscalate" sourceRef="reviewOverdueTimer" targetRef="escalateOverdueReview"/>
    <userTask id="escalateOverdueReview" name="Leo thang hồ sơ HTX quá hạn 15 ngày" flowable:candidateGroups="ocop-officer,admin"/>
    <sequenceFlow id="fTimerEscEnd" sourceRef="escalateOverdueReview" targetRef="endTimerEscalated"/>
    <endEvent id="endTimerEscalated" name="Đã leo thang quá hạn"/>

    <sequenceFlow id="f2" sourceRef="reviewByCoop" targetRef="decision"/>

    <exclusiveGateway id="decision" name="Kết quả sơ duyệt" default="fReject"/>
    <sequenceFlow id="fApprove" name="Đạt" sourceRef="decision" targetRef="councilModeGateway">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'approve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRevise" name="Cần bổ sung" sourceRef="decision" targetRef="reviseByApplicant">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'revise'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fReject" name="Không đạt" sourceRef="decision" targetRef="endRejected"/>

    <userTask id="reviseByApplicant" name="Người nộp bổ sung hồ sơ" flowable:candidateGroups="producer"/>
    <sequenceFlow id="f3" sourceRef="reviseByApplicant" targetRef="reviewByCoop"/>

    <!-- Rẽ nhánh Hội đồng OCOP: nếu truyền danh sách councilMembers thì mở Parallel Multi-Instance, mặc định đi thẳng officialResult -->
    <exclusiveGateway id="councilModeGateway" name="Chế độ chấm điểm Hội đồng" default="fDirectOfficial"/>
    <sequenceFlow id="fToCouncil" name="Chấm Hội đồng song song" sourceRef="councilModeGateway" targetRef="councilScoring">
      <conditionExpression xsi:type="tFormalExpression">${councilMembers != null &amp;&amp; councilMembers.size() &gt; 0}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fDirectOfficial" name="Chuyển thẳng ghi kết quả" sourceRef="councilModeGateway" targetRef="officialResult"/>

    <userTask id="councilScoring" name="Thành viên Hội đồng OCOP chấm điểm độc lập" flowable:assignee="${councilMember}">
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="councilMembers" flowable:elementVariable="councilMember">
        <completionCondition>${nrOfCompletedInstances &gt;= minQuorum}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <sequenceFlow id="fCouncilDone" sourceRef="councilScoring" targetRef="officialResult"/>

    <userTask id="officialResult" name="Ghi kết quả OCOP chính thức (cơ quan có thẩm quyền)" flowable:candidateGroups="ocop-officer"/>
    <sequenceFlow id="f4" sourceRef="officialResult" targetRef="endDone"/>

    <endEvent id="endDone" name="Đã có kết quả chính thức"/>
    <endEvent id="endRejected" name="Không đạt sơ duyệt"/>
  </process>
</definitions>
